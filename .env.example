# Core Environment Configuration
PORT=3000
NODE_ENV=production
JWT_SECRET=super_secret_jwt_key_telecrm_change_me_in_production

# Optional: Render Persistent Disk Path for SQLite
# If using a Render Disk (e.g. mounted at /var/data), uncomment:
# DATABASE_PATH=/var/data/telecrm_local.sqlite

# Optional: External MySQL Database
# If connecting to an external MySQL / MariaDB database instead of SQLite:
# MYSQL_HOST=your-mysql-host.example.com
# MYSQL_PORT=3306
# MYSQL_USER=your_mysql_user
# MYSQL_PASSWORD=your_mysql_password
# MYSQL_DATABASE=telecrm

# GEMINI_API_KEY: Optional/Required for Gemini AI Smart Transcription and Features
GEMINI_API_KEY=your_gemini_api_key_here

# APP_URL: Optional for domain routing / OAuth
APP_URL=https://your-app-name.onrender.com
